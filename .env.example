# Copie este archivo como .env para cambiar los valores por defecto.
# Sin archivo .env, docker compose usa estos mismos valores.

POSTGRES_USER=as4
POSTGRES_PASSWORD=as4_solo_local
POSTGRES_DB=as4compara

# Clave para firmar la cookie de sesión. Si se deja vacía, el servicio genera una
# al arrancar y las sesiones abiertas se cierran cada vez que se reinicia.
SESSION_SECRET=

# Puerto del equipo en el que queda disponible la aplicación.
WEB_PORT=8080
